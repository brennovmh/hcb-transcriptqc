# Caches de Python e ferramentas
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
*.egg-info/
.venv/
venv/

# Dados reais: manter apenas metadados e referências pequenas/autorizadas
real_data/*/
!real_data/samplesheet_*.csv
!real_data/references/
!real_data/references/*.bed
!real_data/references/*.txt
!real_data/references/*.chain.gz

# Fixtures pequenos de teste podem ser versionados explicitamente
!tests/data/
!tests/data/**

